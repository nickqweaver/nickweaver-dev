# Copy to .dev.vars for `npm run dev` / `npm run preview` without SST.
# These mimic the bindings SST links into the deployed Worker (see sst.config.ts).
SST_RESOURCE_App={"name":"nickweaver-dev","stage":"local"}
# Discord webhook that receives contact form submissions (POST /api/contact).
SST_RESOURCE_DiscordWebhookUrl={"value":"https://discord.com/api/webhooks/<id>/<token>"}
